# ---- Database (PostgreSQL) ----
# Local dev: run `npm run db:local` (embedded Postgres, no install needed) and use:
DATABASE_URL="postgresql://wedora:wedora@localhost:54329/wedora?schema=public"
DIRECT_URL="postgresql://wedora:wedora@localhost:54329/wedora?schema=public"

# ---- Auth / sessions ----
# Required in production. 32+ random chars: `openssl rand -base64 48`
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Supabase (optional; Auth/Storage adapters are not enabled by default) ----
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- AI (optional; a deterministic mock planner is used when empty) ----
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---- Maps (optional; static map placeholder when empty) ----
GOOGLE_MAPS_API_KEY=""

# ---- Payments (optional; mock provider when empty) ----
PAYMOB_API_KEY=""
STRIPE_SECRET_KEY=""

# ---- Email (optional; emails are logged to the server console when empty) ----
RESEND_API_KEY=""
EMAIL_FROM="WEDORA <hello@wedora.example>"
