// WEDORA — PostgreSQL schema (Prisma)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  COUPLE
  VENDOR
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum RSVPStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VendorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum NotificationType {
  BOOKING_REQUESTED
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  BOOKING_CHANGES_REQUESTED
  NEW_MESSAGE
  TASK_DEADLINE
  RSVP_RECEIVED
  VENDOR_VERIFIED
  VENDOR_APPROVED
  VENDOR_REJECTED
  AI_RECOMMENDATION
  NEW_REVIEW
  SYSTEM
}

enum WebsiteTemplate {
  CLASSIC_LUXURY
  MODERN_MINIMAL
  ROMANTIC_GARDEN
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique
  passwordHash    String?
  role            UserRole       @default(COUPLE)
  emailVerifiedAt DateTime?
  suspended       Boolean        @default(false)
  /// Bumped on password reset so existing sessions become invalid.
  tokenVersion    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  profile         Profile?
  couple          Couple?
  vendor          Vendor?
  notifications   Notification[]
  messages        Message[]
  authTokens      AuthToken[]

  @@index([role])
}

model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      TokenType
  /// SHA-256 of the raw token. The raw token is only ever sent by email.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  name      String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Couple {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @unique @db.Uuid
  partnerName   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wedding       Wedding?
  favorites     FavoriteVendor[]
  conversations Conversation[]
  aiPlans       AIRecommendation[]
}

model Wedding {
  id              String          @id @default(uuid()) @db.Uuid
  coupleId        String          @unique @db.Uuid
  title           String          @default("Our Wedding")
  date            DateTime?
  city            String?
  guestCount      Int?
  style           String?
  venuePreference String?
  priorities      String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  couple          Couple          @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  tasks           WeddingTask[]
  guests          Guest[]
  guestGroups     GuestGroup[]
  budget          WeddingBudget?
  website         WeddingWebsite?
  bookings        VendorBooking[]
}

// ───────────────────────────── Marketplace ─────────────────────────────

model VendorCategory {
  id      String   @id @default(uuid()) @db.Uuid
  name    String   @unique
  slug    String   @unique
  /// Public route slug, e.g. "photographers" for Photography.
  route   String   @unique
  tagline String?
  image   String?
  vendors Vendor[]
}

model Vendor {
  id            String                   @id @default(uuid()) @db.Uuid
  userId        String?                  @unique @db.Uuid
  categoryId    String                   @db.Uuid
  name          String
  slug          String                   @unique
  city          String
  area          String?
  address       String?
  latitude      Float?
  longitude     Float?
  description   String                   @db.Text
  startingPrice Decimal                  @db.Decimal(12, 2)
  capacity      Int?
  styles        String[]
  phone         String?
  email         String?
  instagram     String?
  imageUrl      String?
  coverUrl      String?
  /// Denormalised from visible reviews; recomputed in a transaction on change.
  rating        Float                    @default(0)
  reviewCount   Int                      @default(0)
  viewCount     Int                      @default(0)
  /// Admin has approved the listing for the public marketplace.
  approved      Boolean                  @default(false)
  verification  VendorVerificationStatus @default(PENDING)
  featured      Boolean                  @default(false)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  user          User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category      VendorCategory           @relation(fields: [categoryId], references: [id])
  services      VendorService[]
  packages      VendorPackage[]
  portfolio     VendorPortfolio[]
  reviews       VendorReview[]
  availability  VendorAvailability[]
  bookings      VendorBooking[]
  favorites     FavoriteVendor[]
  conversations Conversation[]

  @@index([categoryId, city, startingPrice])
  @@index([approved, featured])
  @@index([city])
  @@index([rating])
}

model VendorService {
  id          String          @id @default(uuid()) @db.Uuid
  vendorId    String          @db.Uuid
  name        String
  description String?
  price       Decimal         @db.Decimal(12, 2)
  vendor      Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookings    VendorBooking[]

  @@index([vendorId])
}

model VendorPackage {
  id          String          @id @default(uuid()) @db.Uuid
  vendorId    String          @db.Uuid
  name        String
  description String?
  price       Decimal         @db.Decimal(12, 2)
  features    String[]
  vendor      Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookings    VendorBooking[]

  @@index([vendorId])
}

model VendorPortfolio {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @db.Uuid
  imageUrl  String
  caption   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, position])
}

model VendorReview {
  id        String        @id @default(uuid()) @db.Uuid
  vendorId  String        @db.Uuid
  /// One review per completed booking (enforced by the unique constraint).
  bookingId String        @unique @db.Uuid
  rating    Int
  comment   String?       @db.Text
  photos    String[]
  /// Hidden by an admin moderator; excluded from public listing and averages.
  hidden    Boolean       @default(false)
  createdAt DateTime      @default(now())
  vendor    Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  booking   VendorBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([vendorId, hidden, createdAt])
}

model VendorAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @db.Uuid
  date      DateTime @db.Date
  available Boolean  @default(false)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, date])
}

model VendorBooking {
  id               String         @id @default(uuid()) @db.Uuid
  weddingId        String         @db.Uuid
  vendorId         String         @db.Uuid
  serviceId        String?        @db.Uuid
  packageId        String?        @db.Uuid
  /// Snapshots so history survives later edits/deletes of services & packages.
  serviceName      String?
  packageName      String?
  eventDate        DateTime       @db.Date
  notes            String?        @db.Text
  totalPrice       Decimal?       @db.Decimal(12, 2)
  status           BookingStatus  @default(PENDING)
  vendorNote       String?        @db.Text
  changesRequested Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  wedding          Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendor           Vendor         @relation(fields: [vendorId], references: [id])
  service          VendorService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  package          VendorPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  review           VendorReview?
  payment          Payment?

  @@index([vendorId, status])
  @@index([weddingId, status])
  @@index([vendorId, eventDate])
}

model FavoriteVendor {
  id        String   @id @default(uuid()) @db.Uuid
  coupleId  String   @db.Uuid
  vendorId  String   @db.Uuid
  createdAt DateTime @default(now())
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([coupleId, vendorId])
  @@index([vendorId])
}

// ───────────────────────────── Planning ─────────────────────────────

model WeddingTask {
  id             String       @id @default(uuid()) @db.Uuid
  weddingId      String       @db.Uuid
  title          String
  notes          String?
  category       String
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?    @db.Date
  completedAt    DateTime?
  /// Set once a TASK_DEADLINE notification has been sent, so we never double-notify.
  reminderSentAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  wedding        Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId, status])
  @@index([weddingId, dueDate])
}

model WeddingBudget {
  id           String              @id @default(uuid()) @db.Uuid
  weddingId    String              @unique @db.Uuid
  total        Decimal             @db.Decimal(14, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  wedding      Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  categories   BudgetCategory[]
  transactions BudgetTransaction[]
}

model BudgetCategory {
  id           String              @id @default(uuid()) @db.Uuid
  budgetId     String              @db.Uuid
  name         String
  planned      Decimal             @default(0) @db.Decimal(14, 2)
  budget       WeddingBudget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  transactions BudgetTransaction[]

  @@unique([budgetId, name])
}

model BudgetTransaction {
  id         String         @id @default(uuid()) @db.Uuid
  budgetId   String         @db.Uuid
  categoryId String         @db.Uuid
  title      String
  amount     Decimal        @db.Decimal(14, 2)
  note       String?
  spentAt    DateTime       @default(now()) @db.Date
  createdAt  DateTime       @default(now())
  budget     WeddingBudget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category   BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([budgetId, spentAt])
}

model GuestGroup {
  id        String  @id @default(uuid()) @db.Uuid
  weddingId String  @db.Uuid
  name      String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guests    Guest[]

  @@unique([weddingId, name])
}

model Guest {
  id             String      @id @default(uuid()) @db.Uuid
  weddingId      String      @db.Uuid
  groupId        String?     @db.Uuid
  name           String
  phone          String?
  email          String?
  /// Normalised phone/email used to match public RSVP submissions to guests.
  contactKey     String?
  partySize      Int         @default(1)
  mealPreference String?
  notes          String?
  status         RSVPStatus  @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  wedding        Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  group          GuestGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  rsvps          RSVP[]

  @@unique([weddingId, contactKey])
  @@index([weddingId, status])
}

// ───────────────────────────── Wedding website ─────────────────────────────

model WeddingWebsite {
  id           String                  @id @default(uuid()) @db.Uuid
  weddingId    String                  @unique @db.Uuid
  slug         String                  @unique
  template     WebsiteTemplate         @default(CLASSIC_LUXURY)
  headline     String?
  story        String?                 @db.Text
  heroImage    String?
  gallery      String[]
  venueName    String?
  venueAddress String?
  dressCode    String?
  contactEmail String?
  contactPhone String?
  rsvpEnabled  Boolean                 @default(true)
  published    Boolean                 @default(false)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  wedding      Wedding                 @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  sections     WeddingWebsiteSection[]
  rsvps        RSVP[]
}

model WeddingWebsiteSection {
  id        String         @id @default(uuid()) @db.Uuid
  websiteId String         @db.Uuid
  /// e.g. "schedule"
  kind      String
  content   Json
  position  Int            @default(0)
  website   WeddingWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, kind, position])
}

model RSVP {
  id             String         @id @default(uuid()) @db.Uuid
  websiteId      String         @db.Uuid
  guestId        String?        @db.Uuid
  name           String
  contact        String
  contactKey     String
  attendance     RSVPStatus
  partySize      Int            @default(1)
  mealPreference String?
  message        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  website        WeddingWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  guest          Guest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)

  /// One response per contact per website; re-submitting updates it.
  @@unique([websiteId, contactKey])
}

// ───────────────────────────── Communication ─────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  href      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  coupleId      String    @db.Uuid
  vendorId      String    @db.Uuid
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  couple        Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([coupleId, vendorId])
  @@index([vendorId, lastMessageAt])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  body           String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  subject   String
  message   String   @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ───────────────────────────── Payments ─────────────────────────────

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  bookingId   String        @unique @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("EGP")
  provider    String
  providerRef String?
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  booking     VendorBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  invoice     Invoice?
}

model Invoice {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @unique @db.Uuid
  number    String   @unique
  issuedAt  DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── AI ─────────────────────────────

model AIRecommendation {
  id        String   @id @default(uuid()) @db.Uuid
  coupleId  String   @db.Uuid
  kind      String
  /// "openai" | "mock" — so we never present a mock plan as AI-generated.
  source    String   @default("mock")
  input     Json?
  content   Json
  createdAt DateTime @default(now())
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId, createdAt])
}

// ───────────────────────────── Content ─────────────────────────────

model BlogCategory {
  id    String     @id @default(uuid()) @db.Uuid
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]
}

model BlogPost {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique
  title       String
  excerpt     String
  content     String       @db.Text
  coverImage  String?
  categoryId  String       @db.Uuid
  authorName  String       @default("The WEDORA Team")
  published   Boolean      @default(false)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  category    BlogCategory @relation(fields: [categoryId], references: [id])

  @@index([published, publishedAt])
  @@index([categoryId])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
