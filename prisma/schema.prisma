generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  COUPLE
  VENDOR
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum RSVPStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VendorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  role          UserRole       @default(COUPLE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       Profile?
  couple        Couple?
  vendor        Vendor?
  notifications Notification[]
}

model Profile {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @unique @db.Uuid
  name      String?
  phone     String?
  avatarUrl String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Couple {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @unique @db.Uuid
  partnerName String?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wedding     Wedding?
  favorites   FavoriteVendor[]
}

model Wedding {
  id          String          @id @default(uuid()) @db.Uuid
  coupleId    String          @unique @db.Uuid
  title       String          @default("Our Wedding")
  date        DateTime?
  city        String?
  guestCount  Int?
  budgetTotal Decimal?        @db.Decimal(12, 2)
  couple      Couple          @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  tasks       WeddingTask[]
  guests      Guest[]
  budget      WeddingBudget?
  website     WeddingWebsite?
  bookings    VendorBooking[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model VendorCategory {
  id      String   @id @default(uuid()) @db.Uuid
  name    String   @unique
  slug    String   @unique
  vendors Vendor[]
}

model Vendor {
  id            String                   @id @default(uuid()) @db.Uuid
  userId        String?                  @unique @db.Uuid
  categoryId    String                   @db.Uuid
  name          String
  slug          String                   @unique
  city          String
  area          String?
  description   String                   @db.Text
  startingPrice Decimal                  @db.Decimal(12, 2)
  rating        Float                    @default(0)
  reviewCount   Int                      @default(0)
  verification  VendorVerificationStatus @default(PENDING)
  featured      Boolean                  @default(false)
  styles        String[]
  imageUrl      String?
  user          User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category      VendorCategory           @relation(fields: [categoryId], references: [id])
  services      VendorService[]
  portfolio     VendorPortfolio[]
  reviews       VendorReview[]
  availability  VendorAvailability[]
  bookings      VendorBooking[]
  favorites     FavoriteVendor[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([categoryId, city, startingPrice])
}

model VendorService {
  id          String  @id @default(uuid()) @db.Uuid
  vendorId    String  @db.Uuid
  name        String
  description String?
  price       Decimal @db.Decimal(12, 2)
  vendor      Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorPortfolio {
  id       String  @id @default(uuid()) @db.Uuid
  vendorId String  @db.Uuid
  imageUrl String
  caption  String?
  vendor   Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorReview {
  id        String        @id @default(uuid()) @db.Uuid
  vendorId  String        @db.Uuid
  bookingId String        @unique @db.Uuid
  rating    Int
  comment   String?
  vendor    Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  booking   VendorBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

model VendorAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @db.Uuid
  date      DateTime
  available Boolean  @default(true)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, date])
}

model VendorBooking {
  id          String        @id @default(uuid()) @db.Uuid
  weddingId   String        @db.Uuid
  vendorId    String        @db.Uuid
  serviceName String?
  eventDate   DateTime
  notes       String?
  status      BookingStatus @default(PENDING)
  wedding     Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendor      Vendor        @relation(fields: [vendorId], references: [id])
  review      VendorReview?
  payment     Payment?
  createdAt   DateTime      @default(now())

  @@index([vendorId, status])
}

model FavoriteVendor {
  id        String   @id @default(uuid()) @db.Uuid
  coupleId  String   @db.Uuid
  vendorId  String   @db.Uuid
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([coupleId, vendorId])
}

model WeddingTask {
  id        String       @id @default(uuid()) @db.Uuid
  weddingId String       @db.Uuid
  title     String
  category  String
  status    TaskStatus   @default(TODO)
  priority  TaskPriority @default(MEDIUM)
  dueDate   DateTime?
  wedding   Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([weddingId, status])
}

model BudgetCategory {
  id           String              @id @default(uuid()) @db.Uuid
  name         String              @unique
  transactions BudgetTransaction[]
}

model WeddingBudget {
  id           String              @id @default(uuid()) @db.Uuid
  weddingId    String              @unique @db.Uuid
  total        Decimal             @db.Decimal(12, 2)
  wedding      Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  transactions BudgetTransaction[]
}

model BudgetTransaction {
  id         String         @id @default(uuid()) @db.Uuid
  budgetId   String         @db.Uuid
  categoryId String         @db.Uuid
  amount     Decimal        @db.Decimal(12, 2)
  note       String?
  spentAt    DateTime       @default(now())
  budget     WeddingBudget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category   BudgetCategory @relation(fields: [categoryId], references: [id])
}

model GuestGroup {
  id     String  @id @default(uuid()) @db.Uuid
  name   String
  guests Guest[]
}

model Guest {
  id             String      @id @default(uuid()) @db.Uuid
  weddingId      String      @db.Uuid
  groupId        String?     @db.Uuid
  name           String
  phone          String?
  email          String?
  partySize      Int         @default(1)
  mealPreference String?
  notes          String?
  status         RSVPStatus  @default(PENDING)
  wedding        Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  group          GuestGroup? @relation(fields: [groupId], references: [id])
}

model RSVP {
  id             String         @id @default(uuid()) @db.Uuid
  websiteId      String         @db.Uuid
  name           String
  contact        String?
  attendance     RSVPStatus
  partySize      Int            @default(1)
  mealPreference String?
  message        String?
  website        WeddingWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
}

model WeddingWebsite {
  id        String                  @id @default(uuid()) @db.Uuid
  weddingId String                  @unique @db.Uuid
  slug      String                  @unique
  template  String                  @default("classic")
  story     String?
  heroImage String?
  published Boolean                 @default(false)
  wedding   Wedding                 @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  sections  WeddingWebsiteSection[]
  rsvps     RSVP[]
}

model WeddingWebsiteSection {
  id        String         @id @default(uuid()) @db.Uuid
  websiteId String         @db.Uuid
  kind      String
  content   Json
  position  Int
  website   WeddingWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  coupleId  String    @db.Uuid
  vendorId  String    @db.Uuid
  messages  Message[]
  createdAt DateTime  @default(now())

  @@unique([coupleId, vendorId])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  body           String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @unique @db.Uuid
  amount    Decimal       @db.Decimal(12, 2)
  provider  String
  status    PaymentStatus @default(PENDING)
  booking   VendorBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  invoice   Invoice?
}

model Invoice {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @unique @db.Uuid
  number    String   @unique
  issuedAt  DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model AIRecommendation {
  id        String   @id @default(uuid()) @db.Uuid
  coupleId  String   @db.Uuid
  kind      String
  content   Json
  createdAt DateTime @default(now())

  @@index([coupleId, createdAt])
}
